# Authentication and sync secrets
CURSOR_SIGNING_KEY=replace-with-a-random-secret
PAGE_TOKEN_SIGNING_KEY=replace-with-a-different-random-secret
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_HASH_PEPPER=replace-with-at-least-32-other-random-characters

# Optional mail aggregation. Uncomment after generating a base64-encoded 32-byte key.
# MAIL_CREDENTIAL_KEY=

# Current direct-IP deployment.
PUBLIC_WEB_BASE_URL=http://YOUR_SERVER_IP
CORS_ALLOWED_ORIGINS=http://YOUR_SERVER_IP

# Optional image name/tag. Local build mode defaults to lifetrace-cloud:local.
# Set this only when you want a custom local tag or when using pull mode.
# LIFETRACE_CLOUD_IMAGE=ghcr.io/lifetracemanage/lifetrace-cloud:main

# Optional build parallelism for small servers (Compose default: 2).
# CARGO_BUILD_JOBS=2
