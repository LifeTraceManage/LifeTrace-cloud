# Authentication and sync secrets
CURSOR_SIGNING_KEY=replace-with-a-random-secret
PAGE_TOKEN_SIGNING_KEY=replace-with-a-different-random-secret
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_HASH_PEPPER=replace-with-at-least-32-other-random-characters

# Optional mail aggregation. Uncomment after generating a base64-encoded 32-byte key.
# MAIL_CREDENTIAL_KEY=

# Public HTTPS hostname. DNS A/AAAA must point to this server.
LIFETRACE_DOMAIN=lifetrace.store

# Production deploy builds the application images locally.
LIFETRACE_WEB_IMAGE=lifetrace-web-app:local
LIFETRACE_CLOUD_IMAGE=lifetrace-cloud:local

# Caddy terminates TLS and renews the public certificate automatically.
LIFETRACE_CADDY_IMAGE=caddy:2-alpine
