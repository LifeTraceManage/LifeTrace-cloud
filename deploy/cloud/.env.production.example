# Required
POSTGRES_PASSWORD=replace-with-a-strong-password
CURSOR_SIGNING_KEY=replace-with-a-random-secret
PAGE_TOKEN_SIGNING_KEY=replace-with-a-different-random-secret
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_HASH_PEPPER=replace-with-at-least-32-other-random-characters

# Mail worker. Generate a 32-byte key and encode it with base64.
MAIL_CREDENTIAL_KEY=replace-with-base64-encoded-32-byte-key

# Public direct-IP profile used by the current personal server deployment.
PUBLIC_WEB_BASE_URL=http://8.148.75.45
CORS_ALLOWED_ORIGINS=http://8.148.75.45
BEECOUNT_PUBLIC_BASE_URL=http://8.148.75.45:8869

