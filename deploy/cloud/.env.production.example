# Authentication and sync secrets
CURSOR_SIGNING_KEY=replace-with-a-random-secret
PAGE_TOKEN_SIGNING_KEY=replace-with-a-different-random-secret
AUTH_PASSWORD_PEPPER=replace-with-at-least-32-random-characters
AUTH_TOKEN_HASH_PEPPER=replace-with-at-least-32-other-random-characters

# Optional mail aggregation. Uncomment after generating a base64-encoded 32-byte key.
# MAIL_CREDENTIAL_KEY=

# Optional Agent model. Without MODEL_API_KEY the assistant stays available
# in local fallback mode but does not run the LLM/tool loop.
#
# DeepSeek:
MODEL_PROVIDER=deepseek
# MODEL_API_KEY=
MODEL_BASE_URL=https://api.deepseek.com
MODEL_NAME=deepseek-chat
#
# Qwen example:
# MODEL_PROVIDER=qwen
# MODEL_API_KEY=
# MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# MODEL_NAME=qwen-plus
#
# Any OpenAI-compatible endpoint:
# MODEL_PROVIDER=openai-compatible
# MODEL_API_KEY=
# MODEL_BASE_URL=https://your-provider.example/v1
# MODEL_NAME=your-model
#
# Legacy DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL are still accepted
# when MODEL_PROVIDER remains deepseek.

# Optional Agent sandbox job runner. Disabled by default.
# The Agent can only list administrator-registered jobs and propose a run for approval;
# it never receives a generic shell/command tool.
AGENT_SANDBOX_ENABLED=false
AGENT_SANDBOX_JOBS_DIR=/data/agent-jobs
AGENT_SANDBOX_RUNS_DIR=/data/agent-sandbox-runs
AGENT_SANDBOX_MAX_TIMEOUT_SECONDS=120
AGENT_SANDBOX_MAX_INPUT_BYTES=32768
AGENT_SANDBOX_MAX_OUTPUT_BYTES=65536

# Public endpoints
LIFETRACE_DOMAIN=lifetrace.store
LIFETRACE_PUBLIC_IP=43.142.88.57
PUBLIC_WEB_BASE_URL=https://lifetrace.store

# During the ICP/DNS transition both origins are accepted.
CORS_ALLOWED_ORIGINS=https://lifetrace.store,http://43.142.88.57

# Temporary transition setting: required for authenticated access over plain HTTP IP.
# After the domain is fully available over HTTPS, set this to true and stop using
# the HTTP IP endpoint for authenticated access.
AUTH_COOKIE_SECURE=false

# Production deploy builds the application images locally.
LIFETRACE_WEB_IMAGE=lifetrace-web-app:local
LIFETRACE_CLOUD_IMAGE=lifetrace-cloud:local

# Caddy terminates TLS for the domain and also keeps the HTTP IP fallback alive.
LIFETRACE_CADDY_IMAGE=caddy:2-alpine

# Logging. Increase individual targets when diagnosing a subsystem, for example:
# RUST_LOG=info,lifetrace::mail=debug,lifetrace::http=info
RUST_LOG=info
